% nitw-report.sty -- layout of the NIT Warangal Phase I progress report template (measured from the template PDF)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{nitw-report}[2026/11/06 NITW Phase I report layout]

% ---- fonts: Latin Modern, 12 pt body (class option), as in the template
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}
\RequirePackage{textcomp}
\RequirePackage{amsmath,amssymb,bm}
% (no microtype: the template has neither font expansion nor margin protrusion)
\widowpenalty=10000 \clubpenalty=10000       % never leave a single line of a paragraph alone on a page
\setlength{\emergencystretch}{1.5em}           % only used where a line could not be broken otherwise

% ---- page: A4, left 1.25 in, right 1 in, top 1 in, bottom 1 in; header 25 pt above the text, footer 30 pt below
\RequirePackage[a4paper,left=1.25in,right=1in,top=1in,bottom=1in,headheight=15pt,headsep=25pt,footskip=30pt]{geometry}

% ---- spacing: line spacing x1.4 (20.2 pt baselines), 4 pt between paragraphs, 1.5 em indent
\RequirePackage{setspace}
\setstretch{1.4}
\setlength{\parskip}{4pt}
\setlength{\parindent}{1.5em}
\raggedbottom

% ---- graphics, tables, lists, links
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{multirow}
\RequirePackage{adjustbox}
\RequirePackage{xcolor}
\RequirePackage{enumitem}
\RequirePackage{tikz}
\usetikzlibrary{positioning,arrows.meta,fit,calc}
\RequirePackage[numbers,sort&compress]{natbib}
\RequirePackage[colorlinks=true,linkcolor=blue,citecolor=blue,urlcolor=blue]{hyperref}
\RequirePackage{xurl}

% ---- captions: small type, bold label, no colon, single spaced; table captions above, figure captions below
\RequirePackage[font={small,stretch=1.0},labelfont=bf,labelsep=space,justification=justified,singlelinecheck=true,
                skip=6pt]{caption}
\renewcommand{\arraystretch}{1.12}
% tables are single-spaced inside (template: wrapped cell lines 13.55 pt apart, rows 1.12 x that)
\RequirePackage{etoolbox}
\AtBeginEnvironment{table}{\setstretch{1.0}}
\AtBeginEnvironment{longtable}{\setstretch{1.0}}

% ---- floats: keep figures/tables near their text and avoid half-empty pages
\renewcommand{\topfraction}{0.9}
\renewcommand{\bottomfraction}{0.8}
\renewcommand{\textfraction}{0.07}
\renewcommand{\floatpagefraction}{0.75}
\setcounter{topnumber}{3}
\setcounter{bottomnumber}{2}
\setcounter{totalnumber}{5}

% ---- running header / footer: "Chapter N. Title" left, page number right, 0.4 pt rules top and bottom
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\nouppercase{\leftmark}}
\fancyhead[R]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0.4pt}
\renewcommand{\chaptermark}[1]{\markboth{\chaptername\ \thechapter.\ #1}{}}
\renewcommand{\sectionmark}[1]{}
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\thepage}\renewcommand{\headrulewidth}{0pt}\renewcommand{\footrulewidth}{0pt}}

% ---- chapter heading: every chapter starts at the top of a NEW page; "Chapter N" and the title in \Huge bold, left
\makeatletter
\renewcommand{\@makechapterhead}[1]{%
  \vspace*{50\p@}{\parindent\z@\raggedright\normalfont
  \Huge\bfseries\@chapapp\space\thechapter\par\nobreak\vskip 30\p@
  \interlinepenalty\@M\Huge\bfseries #1\par\nobreak\vskip 40\p@}}
\renewcommand{\@makeschapterhead}[1]{%
  \vspace*{50\p@}{\parindent\z@\raggedright\normalfont\interlinepenalty\@M\Huge\bfseries #1\par\nobreak\vskip 40\p@}}
\makeatother

% ---- front-matter headings (acknowledgements, abstract, abbreviations): \huge bold, left
% Acknowledgements, Abstract, List of Abbreviations: \LARGE bold heading, left (template)
\newlength{\frontheadbefore}\setlength{\frontheadbefore}{71.14pt}
\newlength{\frontheadafter}\setlength{\frontheadafter}{28.44pt}
\newcommand{\frontheading}[1]{%
  \vspace*{\frontheadbefore}{\noindent\LARGE\bfseries #1\par}\nobreak\vskip\frontheadafter\relax}
\newcommand{\frontpageheading}[1]{{\centering\Large\bfseries #1\par}}

% ---- table of contents: front-matter and chapter entries bold, blue links (hyperref)
\RequirePackage[titles]{tocloft}   % titles made by \chapter* exactly like the template
\renewcommand{\cftchapfont}{\bfseries}
\renewcommand{\cftchappagefont}{\bfseries}
\setlength{\cftbeforechapskip}{1em}
\setlength{\cftparskip}{4pt}          % template keeps the 4 pt paragraph gap between entries
\renewcommand{\cftfigpresnum}{}
% Contents and the lists of figures and tables are set at 1.2 line stretch, the references at 1.1 (template)
\newcommand{\liststretch}{1.2}
\newcommand{\refstretch}{1.1}
% references: default IEEE-style labels [n] with hanging text, 9 pt between entries (template)
\apptocmd{\thebibliography}{\setlength{\itemsep}{9pt}\setlength{\parsep}{0pt}\setlength{\parskip}{0pt}}{}{}

% ---- lists as in the template
\setlist{itemsep=2pt,topsep=4pt}
\setlist[itemize]{leftmargin=2.2em}
\setlist[enumerate]{leftmargin=2.2em}

% ---- small helpers
\newcommand{\tabsize}{\small}
\endinput
